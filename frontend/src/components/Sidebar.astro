---
import { getCollection } from 'astro:content';
import { buildTree } from '../lib/tree';
import TreeNode from './TreeNode.astro';

interface Props {
  activeId?: string;
}

const { activeId } = Astro.props;
const entries = await getCollection('materials');
const tree = buildTree(entries);
---

<nav class="tree-nav" id="treeNav">
  <TreeNode nodes={tree} activeId={activeId} />
</nav>

<script>
  const nav = document.getElementById('treeNav');
  if (nav) {
    nav.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const header = target.closest('.tree-item-header.folder') as HTMLElement | null;
      if (!header) return;
      const children = header.nextElementSibling;
      const icon = header.querySelector('.tree-icon');
      children?.classList.toggle('expanded');
      icon?.classList.toggle('expanded');
    });
  }
</script>
