---
import { getCollection } from 'astro:content';

const entries = await getCollection('materials');
const sorted = entries.slice().sort((a, b) => a.id.localeCompare(b.id));
---

<nav class="tree-nav" id="treeNav">
  {sorted.map((entry) => (
    <div class="tree-item">
      <a class="tree-item-header file" href={`/${entry.id}`}>
        <span class="file-icon">📄</span>
        <span class="tree-label">{entry.id}</span>
      </a>
    </div>
  ))}
</nav>
