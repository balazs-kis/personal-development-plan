---
import { sidebarScript } from '../lib/sidebarScript';

interface Props {
  activeId?: string;
}

const { activeId } = Astro.props;
const { url } = await sidebarScript();
---

<!--
  The tree markup comes from the shared, cached /sidebar.js (see lib/sidebarScript.ts). It's a plain
  blocking script on purpose: parsing waits for it, so the tree is in the DOM before the script below
  runs, and the render hold in DocLayout keeps the page from painting without it.
-->
<nav class="tree-nav" id="treeNav" data-active={activeId}>
  <script is:inline src={url}></script>
</nav>

<!--
  Tree behavior: folder toggling, remembered open folders, and search.
  Inline (not bundled) so it runs while the page is still parsing: restored folders and a
  remembered search query apply before the first paint instead of popping in afterwards.
  The search input sits above the tree in DocLayout, so it already exists at this point.
-->
<script is:inline>
  (function () {
    var EXPANDED_KEY = 'sidebar-expanded'; // localStorage: open folder paths, kept across visits
    var SEARCH_KEY = 'sidebar-search'; // sessionStorage: query survives clicking into a result

    var nav = document.getElementById('treeNav');
    var search = document.getElementById('searchInput');
    if (!nav) return;

    function folderHeaders() {
      return nav.querySelectorAll('.tree-item-header.folder');
    }

    function isExpanded(header) {
      return header.nextElementSibling.classList.contains('expanded');
    }

    function setExpanded(header, expanded) {
      header.nextElementSibling.classList.toggle('expanded', expanded);
      header.querySelector('.tree-icon').classList.toggle('expanded', expanded);
    }

    function loadExpanded() {
      try {
        return JSON.parse(localStorage.getItem(EXPANDED_KEY) || '[]');
      } catch (e) {
        return [];
      }
    }

    function saveExpanded() {
      var open = [];
      folderHeaders().forEach(function (h) {
        if (isExpanded(h)) open.push(h.dataset.folder);
      });
      localStorage.setItem(EXPANDED_KEY, JSON.stringify(open));
    }

    // The shared tree markup has no per-page state; mark the current lesson here.
    var activePath = nav.dataset.active || '';
    nav.querySelectorAll('a[data-path]').forEach(function (a) {
      if (a.dataset.path === activePath) a.classList.add('active');
    });

    // Saved folders plus the ancestors of the current lesson, so the active lesson is always visible
    // even if its folder was collapsed last time.
    function restoreExpanded() {
      var saved = loadExpanded();
      folderHeaders().forEach(function (h) {
        var path = h.dataset.folder;
        var isAncestor = activePath.indexOf(path + '/') === 0;
        setExpanded(h, isAncestor || saved.indexOf(path) !== -1);
      });
    }

    function searching() {
      return !!(search && search.value.trim());
    }

    // An item stays visible if its own label matches, an ancestor folder matches (so searching
    // a chapter name shows the whole chapter), or something below it matches. Folders open
    // whenever they contain a visible item, so every result is on screen without extra clicks.
    function visit(item, query, ancestorMatches) {
      var header = item.querySelector(':scope > .tree-item-header');
      var label = header.querySelector('.tree-label').textContent.toLowerCase();
      var selfMatches = label.indexOf(query) !== -1;
      var children = item.querySelector(':scope > .tree-children');
      var hasVisibleChild = false;

      if (children) {
        children.querySelectorAll(':scope > .tree-item').forEach(function (child) {
          if (visit(child, query, ancestorMatches || selfMatches)) hasVisibleChild = true;
        });
        setExpanded(header, hasVisibleChild);
      }

      var visible = selfMatches || ancestorMatches || hasVisibleChild;
      item.style.display = visible ? '' : 'none';
      return visible;
    }

    function applySearch() {
      var query = search ? search.value.trim().toLowerCase() : '';
      if (query) {
        sessionStorage.setItem(SEARCH_KEY, search.value);
        nav.querySelectorAll(':scope > .tree-item').forEach(function (item) {
          visit(item, query, false);
        });
      } else {
        sessionStorage.removeItem(SEARCH_KEY);
        nav.querySelectorAll('.tree-item').forEach(function (item) {
          item.style.display = '';
        });
        restoreExpanded();
      }
    }

    nav.addEventListener('click', function (e) {
      var header = e.target.closest('.tree-item-header.folder');
      if (!header) return;
      setExpanded(header, !isExpanded(header));
      // Folders opened by a search are temporary; only remember manual browsing.
      if (!searching()) saveExpanded();
    });

    if (search) {
      search.value = sessionStorage.getItem(SEARCH_KEY) || '';
      search.addEventListener('input', applySearch);
      search.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && search.value) {
          e.stopPropagation(); // clear the search only; don't also close the mobile sidebar
          search.value = '';
          applySearch();
        }
      });
    }

    applySearch();
  })();
</script>

<script>
  import { initSession, progress } from '../lib/session';

  // Progress markers: ✓ for completed lessons, • for viewed ones.
  const nav = document.getElementById('treeNav');
  if (nav) {
    const links = nav.querySelectorAll<HTMLElement>('a[data-path]');
    progress.subscribe((map) => {
      for (const link of links) {
        const lesson = map.get(link.dataset.path!);
        link.classList.toggle('completed', !!lesson?.completedAt);
        link.classList.toggle('viewed', !!lesson && !lesson.completedAt && lesson.viewCount > 0);
      }
    });
    initSession();
  }
</script>
