---
import type { TreeNode } from '../lib/tree';

interface Props {
  nodes: TreeNode[];
  level?: number;
  activeId?: string;
}

const { nodes, level = 0, activeId } = Astro.props;

function isAncestor(folderPath: string, id: string | undefined): boolean {
  if (!id) return false;
  return id === folderPath || id.startsWith(folderPath + '/');
}
---

{nodes.map((node) => {
  if (node.type === 'folder') {
    const expanded = isAncestor(node.path, activeId);
    return (
      <div class="tree-item" style={`padding-left: ${level * 0.5}rem`}>
        <div class="tree-item-header folder">
          <span class:list={['tree-icon', { expanded }]}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
          <span class="file-icon">📁</span>
          <span class="tree-label">{node.label}</span>
        </div>
        <div class:list={['tree-children', { expanded }]}>
          <Astro.self nodes={node.children} level={level + 1} activeId={activeId} />
        </div>
      </div>
    );
  }
  return (
    <div class="tree-item" style={`padding-left: ${level * 0.5}rem`}>
      <a
        class:list={['tree-item-header', 'file', { active: activeId === node.id }]}
        href={node.href}
        data-path={node.id}
      >
        <span class="tree-icon" style="visibility: hidden;">
          <svg viewBox="0 0 24 24"></svg>
        </span>
        <span class="file-icon">{node.icon}</span>
        <span class="tree-label">{node.label}</span>
      </a>
    </div>
  );
})}
