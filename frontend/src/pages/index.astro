---
import DocLayout from '../layouts/DocLayout.astro';
---

<DocLayout>
  <div class="welcome">
    <h1>Welcome to Your Personal Development Plan</h1>
    <p>Select a topic from the sidebar to get started.</p>
    <div class="quick-start">
      <h2>Quick Start</h2>
      <p>This documentation site contains your learning materials organized by topics, chapters, and lessons.</p>
      <ul>
        <li>Use the <strong>sidebar</strong> to navigate through topics</li>
        <li>Click on folders to expand/collapse them</li>
        <li>Click on files to view their content</li>
        <li>Use the <strong>search</strong> to find specific content</li>
        <li>Toggle <strong>dark/light mode</strong> with the button in the header</li>
      </ul>
    </div>
  </div>
</DocLayout>
