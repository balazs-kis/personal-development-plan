---
import { getCollection, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import LessonProgress from '../components/LessonProgress.svelte';

export async function getStaticPaths() {
  const entries = await getCollection('materials');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<DocLayout title={entry.data.title ?? entry.id} activeId={entry.id}>
  <LessonProgress client:only="svelte" slug={entry.id} />
  <Content />
</DocLayout>
